{
  "type": "vertical-stack",
  "cards": [
    {
      "type": "tile",
      "entity": "select.scm_operation_mode",
      "name": "Solar Climate Manager",
      "icon": "mdi:air-conditioner",
      "features_position": "bottom",
      "tap_action": {
        "action": "more-info"
      },
      "features": [
        {
          "type": "select-options"
        }
      ]
    },
    {
      "type": "entities",
      "title": "Стан і рішення",
      "show_header_toggle": false,
      "state_color": true,
      "entities": [
        {
          "entity": "binary_sensor.scm_running",
          "name": "Кондиціонер увімкнено"
        },
        {
          "entity": "sensor.scm_temperature",
          "name": "Температура кімнати"
        },
        {
          "type": "attribute",
          "entity": "sensor.scm_strategy_action",
          "attribute": "target_temperature_c",
          "name": "Ціль контролера",
          "suffix": " °C",
          "icon": "mdi:thermometer-check"
        },
        {
          "entity": "sensor.scm_strategy_action",
          "name": "Рішення контролера"
        },
        {
          "entity": "sensor.scm_strategy_reason",
          "name": "Причина рішення"
        },
        {
          "type": "section",
          "label": "Що дозволяє або блокує роботу"
        },
        {
          "entity": "binary_sensor.scm_grid_available",
          "name": "Мережа доступна"
        },
        {
          "entity": "binary_sensor.scm_energy_allowed",
          "name": "Енергетичний дозвіл"
        },
        {
          "entity": "sensor.scm_energy_reason",
          "name": "Причина енергетичного дозволу"
        },
        {
          "entity": "binary_sensor.scm_control_allowed",
          "name": "Автоматичні команди дозволені"
        },
        {
          "entity": "binary_sensor.scm_demand",
          "name": "Є температурна потреба"
        },
        {
          "entity": "sensor.scm_manual_status",
          "name": "Ручний пріоритет"
        },
        {
          "type": "section",
          "label": "Налаштування"
        },
        {
          "type": "button",
          "name": "Ціль, гістерезис, SOC і джерела",
          "icon": "mdi:cog",
          "action_name": "Відкрити",
          "tap_action": {
            "action": "navigate",
            "navigation_path": "/config/integrations/integration/solar_climate_manager"
          }
        }
      ]
    },
    {
      "type": "conditional",
      "conditions": [
        {
          "condition": "state",
          "entity": "binary_sensor.scm_command_failed",
          "state": "on"
        }
      ],
      "card": {
        "type": "entities",
        "title": "⚠ Помилка команди",
        "show_header_toggle": false,
        "entities": [
          {
            "entity": "sensor.scm_command_error",
            "name": "Причина помилки"
          }
        ]
      }
    },
    {
      "type": "conditional",
      "conditions": [
        {
          "condition": "state",
          "entity": "binary_sensor.scm_manual_pause",
          "state": "on"
        }
      ],
      "card": {
        "type": "markdown",
        "content": "**Ручна пауза до півночі.** Контролер спостерігає за умовами, але не надсилає команд кондиціонеру."
      }
    },
    {
      "type": "conditional",
      "conditions": [
        {
          "condition": "or",
          "conditions": [
            {
              "condition": "state",
              "entity": "binary_sensor.scm_invalid_data",
              "state": "on"
            },
            {
              "condition": "state",
              "entity": "binary_sensor.scm_energy_data_invalid",
              "state": "on"
            }
          ]
        }
      ],
      "card": {
        "type": "entities",
        "title": "⚠ Перевірте джерела даних",
        "show_header_toggle": false,
        "entities": [
          {
            "entity": "binary_sensor.scm_invalid_data",
            "name": "Проблема температури або кондиціонера"
          },
          {
            "entity": "binary_sensor.scm_energy_data_invalid",
            "name": "Проблема енергетичних даних"
          },
          {
            "entity": "sensor.scm_energy_reason",
            "name": "Причина енергетичного блокування"
          }
        ]
      }
    },
    {
      "type": "entities",
      "title": "Енергетичний баланс",
      "show_header_toggle": false,
      "entities": [
        {
          "entity": "sensor.scm_soc",
          "name": "Заряд батареї"
        },
        {
