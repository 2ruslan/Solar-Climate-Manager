          "name": "Мінімальний SOC",
          "suffix": " %",
          "icon": "mdi:battery-lock"
        },
        {
          "entity": "sensor.scm_pv_power",
          "name": "Сонячна потужність"
        },
        {
          "entity": "sensor.scm_house_load_power",
          "name": "Споживання без заряджання батареї"
        },
        {
          "entity": "sensor.scm_battery_power",
          "name": "Батарея: + розряд / − заряд"
        },
        {
          "entity": "sensor.scm_grid_power",
          "name": "Мережа: + імпорт / − експорт"
        },
        {
          "entity": "sensor.scm_solar_margin",
          "name": "Поточний сонячний баланс"
        },
        {
          "entity": "sensor.scm_average_solar_margin",
          "name": "Середній баланс за 10 хв"
        },
        {
          "entity": "sensor.scm_ac_power",
          "name": "Виміряна потужність кондиціонера"
        },
        {
          "type": "attribute",
          "entity": "sensor.scm_strategy_action",
          "attribute": "estimated_ac_power_w",
          "name": "Оцінка потужності кондиціонера",
          "suffix": " W",
          "icon": "mdi:flash"
        }
      ]
    },
    {
      "type": "entities",
      "title": "Таймери",
      "show_header_toggle": false,
      "entities": [
        {
          "entity": "sensor.scm_seconds_to_start",
